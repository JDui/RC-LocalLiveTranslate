+  // RC language-score adapter: read evidence without changing auto decoding.
+  void ExportLanguageScores(const Ort::Value &logits, OfflineStream **streams,
+                            int32_t count) const {
+    const std::array<std::string, 5> languages = {"zh", "en", "ja", "ko", "yue"};
+    for (int32_t i = 0; i < count; ++i) {
+      for (const auto &language : languages) {
+        streams[i]->SetOption("rc_language_score_" + language, "");
+      }
+    }
+    if (count <= 0 || model_->GetModelMetadata().is_funasr_nano ||
+        !logits.IsTensor()) return;
+    const auto info = logits.GetTensorTypeAndShapeInfo();
+    const auto shape = info.GetShape();
+    if (info.GetElementType() != ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT ||
+        shape.size() != 3 || shape[0] != count || shape[1] <= 0 ||
+        shape[2] <= 0) return;
+    const auto vocabulary_size = static_cast<size_t>(shape[2]);
+    const auto stride = info.GetElementCount() / static_cast<size_t>(count);
+    if (stride < vocabulary_size) return;
+    std::array<int32_t, 5> ids;
+    for (size_t i = 0; i < languages.size(); ++i) {
+      const auto token = "<|" + languages[i] + "|>";
+      if (!symbol_table_.Contains(token)) return;
+      ids[i] = symbol_table_[token];
+    }
+    const auto *data = logits.GetTensorData<float>();
+    for (int32_t i = 0; i < count; ++i) {
+      std::array<float, 5> scores;
+      if (!rc_localtranslate::ReadSenseVoiceLanguageScores(
+              data + static_cast<size_t>(i) * stride, vocabulary_size, ids,
+              &scores)) continue;
+      for (size_t j = 0; j < languages.size(); ++j) {
+        streams[i]->SetOption("rc_language_score_" + languages[j],
+                              std::to_string(scores[j]));
+      }
+    }
+  }
